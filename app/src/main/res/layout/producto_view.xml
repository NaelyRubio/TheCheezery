<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="15dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/producto_img"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:layout_marginEnd="12dp"
        android:src="@drawable/caramel_frap"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/producto_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caramel Frap"
            android:textColor="@color/very_purple"
            android:textStyle="bold"
            android:textSize="18sp"
            />

        <TextView
            android:id="@+id/producto_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripcion del producto"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            />
    </LinearLayout>

    <TextView
        android:id="@+id/producto_precio"
        android:layout_width="101dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="8dp"
        android:text="$0.00"
        android:textColor="@color/pinky"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>